# Copy to .env and fill in. Never commit .env.
QLOO_API_KEY=your-qloo-hackathon-key
QLOO_HACKATHON_SERVER_URL=https://hackathon.api.qloo.com
# The harness defaults to production (api.qloo.com), where hackathon keys get 401.
# Locally: qloo config set base-url https://hackathon.api.qloo.com
# LLM provider for the agent
GROQ_API_KEY=your-groq-key
